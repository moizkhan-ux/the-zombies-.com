---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { students, TRAITS, type Student } from "../../data/students";
import { initials } from "../../lib/utils";

export function getStaticPaths() {
  return students.map((student) => ({
    params: { roll: student.roll },
    props: { student },
  }));
}

interface Props {
  student: Student;
}

const { student: s } = Astro.props;

const titles: Record<string, string> = {
  Excellent: "LEGEND",
  "Very good": "PRO",
  Good: "RISING STAR",
  "Needs improvement": "ROOKIE",
};
const title = titles[s.rating] ?? s.rating;
const top3 = s.rank <= 3;
---

<Layout title={`${s.name} – ACD Academy`}>
  <Navbar />
  <main>
    <section>
      <div class="wrap">
        <article class="card player">
          <div class="panel-l">
            <div class="rank-mark">
              <span class="rank-num">#{s.rank}</span>
              <span class="rank-lbl">RANK</span>
            </div>
            <div class="ava-wrap">
              {top3 && s.gender === "boy" && (
                <span class="crown" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 7.5L7.2 13 12 4.5 16.8 13 21 7.5V19H3V7.5z"></path></svg>
                </span>
              )}
              <div class="avatar big">{initials(s.name)}</div>
              {top3 && s.gender === "girl" && (
                <span class="pookie">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21S5 16.2 2.8 12.2C1 9.6 1.7 5.8 5 4.4 7.2 3.4 9.6 4.2 12 6.8c2.4-2.6 4.8-3.4 7-2.4 3.3 1.4 4 5.2 2.2 7.8C19 16.2 12 21 12 21z"></path></svg>
                  Pookie
                </span>
              )}
            </div>
            <h1 class="pname">{s.name}</h1>
            <small>Roll no. {s.roll}</small>
            <span class="title-badge">{title}</span>
            <div class="giant">
              <b>{s.overall}</b>
              <span>OVERALL</span>
            </div>
          </div>
          <div class="panel-r">
            <div class="pills">
              <span class="best">Perfect at: {s.talent}</span>
              <span class="beh">{s.rating}</span>
            </div>
            <div>
              <h4>About {s.name}</h4>
              <p>{s.about}</p>
            </div>
            <div>
              <h4>Skills</h4>
              {s.skills.map(([label, pct]) => (
                <div class="skill stat">
                  <span>{label}</span>
                  <div class="bar"><i style={`width:${pct}%`}></i></div>
                  <em>{pct}%</em>
                </div>
              ))}
            </div>
            <div>
              <h4>Behaviour</h4>
              {TRAITS.map((t, k) => (
                <div class="skill stat">
                  <span>{t}</span>
                  <div class="bar"><i style={`width:${s.behaviour[k]}%`}></i></div>
                  <em>{s.behaviour[k]}%</em>
                </div>
              ))}
              <p class="bnote">{s.bnote}</p>
            </div>
            <div class="imp">
              <h4>What to improve</h4>
              <ul>
                {s.improve.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
            <a class="btn back" href="/students">Back to students</a>
          </div>
        </article>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
