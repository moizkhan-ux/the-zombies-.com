---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import StudentPortrait from "../../components/StudentPortrait.astro";
import BehaviourRing from "../../components/BehaviourRing.astro";
import { students, TRAITS, type Student } from "../../data/students";
import { barTone, funTitle } from "../../lib/student-ui";
import "../../styles/zombies.css";

export function getStaticPaths() {
  return students.map((student) => ({
    params: { roll: student.roll },
    props: { student },
  }));
}

interface Props {
  student: Student;
}

const { student: s } = Astro.props;
const title = funTitle(s);
const i = students.findIndex((x) => x.roll === s.roll);
const prev = students[(i - 1 + students.length) % students.length];
const next = students[(i + 1) % students.length];
const rankClass = s.rank <= 3 ? `r${s.rank}` : "rx";
---

<Layout title={`${s.name} – ACD Academy`} description={s.tagline}>
  <Navbar />
  <main class="zombies" data-zombies>
    <div class="z-bg" aria-hidden="true">
      <span class="z-fog a"></span>
      <span class="z-fog b"></span>
      <i class="z-ember"></i><i class="z-ember"></i><i class="z-ember"></i>
      <span class="z-vignette"></span>
    </div>
    <section>
      <div class="wrap">
        <article class="z-profile">
          <header class="z-phero">
            <span class:list={["z-rank", rankClass]}>
              {s.rank === 1 ? <span aria-hidden="true">👑</span> : null}
              #{s.rank}
            </span>
            <StudentPortrait name={s.name} roll={s.roll} size="lg" eager />
            <h1 class="z-hero-name">{s.name}</h1>
            <small>Roll no. {s.roll}</small>
            <span class="z-title">{title}</span>
            <BehaviourRing overall={s.overall} rating={s.rating} />
          </header>
          <div class="z-body">
            <blockquote class="z-quote">{s.about}</blockquote>
            <div>
              <h4>Skills</h4>
              {s.skills.map(([label, pct]) => (
                <div class="z-skill">
                  <span>{label}</span>
                  <div class={`z-bar ${barTone(pct)}`} style={`--p:${pct}`}><i></i></div>
                  <em>{pct}%</em>
                </div>
              ))}
            </div>
            <div>
              <h4>Behaviour</h4>
              {TRAITS.map((t, k) => (
                <div class="z-skill">
                  <span>{t}</span>
                  <div class={`z-bar ${barTone(s.behaviour[k])}`} style={`--p:${s.behaviour[k]}`}><i></i></div>
                  <em>{s.behaviour[k]}%</em>
                </div>
              ))}
              <p class="z-quote" style="margin-top:0.7rem">{s.bnote}</p>
            </div>
            <div class="imp">
              <h4>What to improve</h4>
              <ul>
                {s.improve.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
            <div class="z-nav">
              <a href={`/students/${prev.roll}`}>Previous student</a>
              <a class="ghost" href="/students">Back to all students</a>
              <a href={`/students/${next.roll}`}>Next student</a>
            </div>
          </div>
        </article>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import { enhanceZombies } from "../../scripts/zombies";
  document.querySelectorAll<HTMLElement>("[data-zombies]").forEach((el) => enhanceZombies(el));
</script>
