---
import { students } from "../data/students";
import ZombieCard from "./ZombieCard.astro";
import "../styles/zombies.css";
---

<section id="students" class="zombies z-home" data-zombies>
  <div class="wrap">
    <h2>Our students</h2>
    <p class="lead z-lead">Everyone in our class is perfect at something. Here is what.</p>
    <div class="z-grid" id="cards">
      {students.map((s, i) => (
        <ZombieCard student={s} index={i} />
      ))}
    </div>
  </div>
</section>

<script>
  import { enhanceZombies } from "../scripts/zombies";
  document.querySelectorAll<HTMLElement>("[data-zombies]").forEach((el) => enhanceZombies(el));
</script>
