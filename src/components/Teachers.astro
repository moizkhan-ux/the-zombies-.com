---
import { teachersRanked } from "../data/teachers";
import { initials } from "../lib/utils";

const starPath = "M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.3 6.2 20.4l1.1-6.5-4.7-4.6 6.5-.9L12 2.5z";
const fill = (rating: number, i: number) => Math.min(100, Math.max(0, (rating - i) * 100));
---

<section id="teachers">
  <div class="wrap">
    <h2>Our top teachers</h2>
    <p class="lead">The teachers who help us most, ranked by their rating out of 5.</p>
    <div class="tgrid" id="teacherCards">
      {
        teachersRanked.map((t, i) => (
          <article class="card tcard">
            <span class={`trb trb-${i + 1}`}>
              {i === 0 ? (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 7.5L7.2 13 12 4.5 16.8 13 21 7.5V19H3V7.5z"></path></svg>
              ) : (
                `#${i + 1}`
              )}
            </span>
            <div class="top">
              <div class="avatar">{initials(t.name)}</div>
              <div>
                <h3>{t.name}</h3>
                <span class="best">{t.subject}</span>
              </div>
            </div>
            <div class="stars-row">
              <span class="stars" aria-hidden="true">
                {[0, 1, 2, 3, 4].map((n) => (
                  <span class="star">
                    <svg class="star-bg" viewBox="0 0 24 24"><path d={starPath}></path></svg>
                    <span class="star-on" style={`width:${fill(t.rating, n)}%`}>
                      <svg viewBox="0 0 24 24"><path d={starPath}></path></svg>
                    </span>
                  </span>
                ))}
              </span>
              <strong>{t.rating.toFixed(1)} / 5</strong>
            </div>
            <p class="tknow">{t.known}</p>
            <a class="more" href={`/teachers/${t.slug}`}>Description</a>
          </article>
        ))
      }
    </div>
  </div>
</section>
