---
---

<header>
  <nav class="navbar" aria-label="Main">
    <a class="logo" href="/"><i></i><span>The Zombies</span></a>
    <ul>
      <li>
        <a href="/" aria-label="Home">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8"></path><path d="M5 10v10h5v-6h4v6h5V10"></path></svg><span>Home</span>
        </a>
      </li>
      <li>
        <a href="/students" aria-label="Students">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20c0-3.5 3-6 6.5-6s6.5 2.5 6.5 6"></path><path d="M16 4.7a3.5 3.5 0 010 6.6"></path><path d="M18 14.3c2 .7 3.5 2.6 3.5 5.7"></path></svg><span>Students</span>
        </a>
      </li>
      <li>
        <a href="/leaderboard" aria-label="Leaderboard">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 21h8"></path><path d="M12 17v4"></path><path d="M7 4h10v6a5 5 0 01-10 0V4z"></path><path d="M7 6H4.5a2.5 2.5 0 002.5 4"></path><path d="M17 6h2.5a2.5 2.5 0 01-2.5 4"></path></svg><span>Leaderboard</span>
        </a>
      </li>
      <li>
        <a href="/game" aria-label="Game">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="2"></circle><path d="M7 9V7a2 2 0 012-2h1"></path><path d="M17 9V7a2 2 0 00-2-2h-1"></path><path d="M7 15v2a2 2 0 002 2h6a2 2 0 002-2v-2"></path><path d="M4 11h2M18 11h2"></path></svg><span>Game</span>
        </a>
      </li>
      <li>
        <a href="/teachers" aria-label="Teachers">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10L12 5 2 10l10 5 10-5z"></path><path d="M6 12v5c0 1 3 3 6 3s6-2 6-3v-5"></path><path d="M22 10v6"></path></svg><span>Teachers</span>
        </a>
      </li>
    </ul>
    <button type="button" class="theme" id="themeBtn" role="switch" aria-checked="false" aria-label="Dark mode">
      <span class="knob">
        <svg class="ico-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 13.5A9 9 0 1110.5 3a7 7 0 0010.5 10.5z"></path></svg>
        <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </span>
    </button>
  </nav>
</header>

<script>
  const b = document.getElementById("themeBtn") as HTMLButtonElement;
  const r = document.documentElement;
  const sync = () => b.setAttribute("aria-checked", String(r.dataset.theme === "dark"));
  sync();
  b.addEventListener("click", () => {
    const t = r.dataset.theme === "dark" ? "light" : "dark";
    r.dataset.theme = t;
    try { localStorage.setItem("theme", t); } catch (e) {}
    sync();
  });
</script>
